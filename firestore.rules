rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: user is signed in
    function signedIn() {
      return request.auth != null;
    }
    
    // Helper: user owns this document
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // plants catalog - public read, admin write
    match /plants/{plantId} {
      allow read: if true;
      allow write: if isAdmin(); // only admin can write
    }

    // inventory - public read, admin write
    match /inventory/{plantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // user's plants - full access to own data
    match /users/{uid}/myPlants/{txId} {
      allow read, write: if isOwner(uid);
    }

    // user's orders - full access to own data
    match /users/{uid}/orders/{txId} {
      allow read, write: if isOwner(uid);
    }

    // admins - only for admin checks
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if isAdmin();
    }

    // Admin helper function
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}